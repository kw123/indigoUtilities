			<State id="cpuSystem">
				<ValueType>Number</ValueType>
				<TriggerLabel>CPU system [%]</TriggerLabel>
				<ControlPageLabel>CPU used by the system (kernel) [%]</ControlPageLabel>
			</State>
			<State id="cpuAvg24h">
