				<Label>energy 8 unit of the source state:</Label>
				<List>
					<Option value="Wh">Wh</Option>
					<Option value="kWh">kWh</Option>
					<Option value="MWh">MWh</Option>
					<Option value="Ws">Ws (J)</Option>
				</List>
			</Field>
			<Field id="sepPrintPropsStates" type="separator"/>
			<Field id="printPropsStates" type="button">
				<Label>print properties and states of this device to indigo log:</Label>
				<Title>PRINT</Title>
				<CallbackMethod>sumMetersPrintCALLBACK</CallbackMethod>
			</Field>
		</ConfigUI>
		<States>
			<!-- power / current / energy sums, slots, statistics and source_ states are created by the plugin (getDeviceStateList), only for the kinds and slots in use -->
			<State id="lastSumUpdate">
				<ValueType>String</ValueType>
				<TriggerLabel>lastSumUpdate</TriggerLabel>
				<ControlPageLabel>lastSumUpdate</ControlPageLabel>
			</State>
		</States>
	</Device>
</Devices>
