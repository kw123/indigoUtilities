				<TriggerLabel>Bridge in max 24h [KB/s]</TriggerLabel>
				<ControlPageLabel>Thunderbolt bridge received, highest interval average of the last 24 hours [KB/s]</ControlPageLabel>
			</State>

			<State id="bridgeOutMax24h">
				<ValueType>Number</ValueType>
				<TriggerLabel>Bridge out max 24h [KB/s]</TriggerLabel>
