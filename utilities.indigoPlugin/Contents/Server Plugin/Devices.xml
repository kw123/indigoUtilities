			</State>
			<State id="memTotalGB">
				<ValueType>Number</ValueType>
				<TriggerLabel>Memory installed [GB]</TriggerLabel>
				<ControlPageLabel>Memory installed [GB]</ControlPageLabel>
			</State>
			<State id="memAvg24h">
				<ValueType>Number</ValueType>
				<TriggerLabel>Memory used average 24h [%]</TriggerLabel>
				<ControlPageLabel>Memory used, average of the last 24 hours [%]</ControlPageLabel>
			</State>
			<State id="memMax24h">
				<ValueType>Number</ValueType>
