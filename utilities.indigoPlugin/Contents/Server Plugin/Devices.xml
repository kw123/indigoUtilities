	<Device type="sensor" id="sumMeters">
		<Name>sumMeters: add up power, current, energy of other devices</Name>
		<UiDisplayStateId>sensorValue</UiDisplayStateId>
		<ConfigUI>
			<Field id="SupportsOnState" type="checkbox" defaultValue="false" hidden="true" />
			<Field id="SupportsSensorValue" type="checkbox" defaultValue="true" hidden="true" />
			<Field id="SupportsStatusRequest" type="checkbox" defaultValue="false" hidden="true" />
			<Field id="AllowSensorValueChange" type="checkbox" defaultValue="false" hidden="true" />
			<Field id="MSG" type="textfield" defaultValue="" readonly="yes">
				<Label>message from plugin:</Label>
			</Field>
			<Field id="label0" type="label">
				<Label>Set the number of sources, then pick for each slot a device, one of its states and its unit. Slots without a device are skipped. The sum is updated whenever one of the source states changes. Works with any indigo device; another sumMeters device can be a source too (sum of sums).</Label>
			</Field>
			<Field id="displaySelect" type="menu" defaultValue="powerSum">
				<Label>Show in device list:</Label>
				<List>
					<Option value="powerSum">power sum</Option>
					<Option value="currentSum">current sum</Option>
					<Option value="energySum">energy sum</Option>
				</List>
			</Field>
			<Field id="sep_power" type="separator"/>
			<Field id="powerCount" type="menu" defaultValue="1">
				<Label>number of power (W) sources:</Label>
				<List>
					<Option value="0">0</Option>
					<Option value="1">1</Option>
					<Option value="2">2</Option>
					<Option value="3">3</Option>
					<Option value="4">4</Option>
					<Option value="5">5</Option>
					<Option value="6">6</Option>
					<Option value="7">7</Option>
					<Option value="8">8</Option>
				</List>
			</Field>
			<Field id="powerSumUnit" type="menu" defaultValue="W">
				<Label>unit of the power sum and of power1..8:</Label>
				<List>
					<Option value="mW">mW</Option>
					<Option value="W">W</Option>
					<Option value="kW">kW</Option>
				</List>
			</Field>
			<Field id="power_EnableMinMax" type="checkbox" defaultValue="true">
				<Label>power sum: daily min / max / ave:</Label>
				<Description>states powerSumMinToday .. powerSumAveYesterday</Description>
			</Field>
			<Field id="powerDev1" type="menu" defaultValue="0" visibleBindingId="powerCount" visibleBindingValue="1,2,3,4,5,6,7,8">
				<Label>power 1 device:</Label>
				<List class="self" filter="power" method="sumMetersFilterDevices"/>
				<CallbackMethod>sumMetersDevCALLBACK</CallbackMethod>
